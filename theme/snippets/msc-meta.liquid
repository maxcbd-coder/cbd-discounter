{%- comment -%}
  Balises meta de la landing, à la marque du nom de domaine (ActuCBD) et non au nom interne de la boutique Shopify.
  Le titre et la description de l'accueil sont définis ici ; les autres pages reprennent page_title / page_description.
{%- endcomment -%}
{%- liquid
  assign brand = 'ActuCBD'
  if template.name == 'index'
    assign seo_title = 'Meilleur site CBD 2026 : top 10 des boutiques | ActuCBD'
    assign seo_description = "Quel est le meilleur site pour acheter du CBD ? 34 boutiques testées, 10 retenues : prix au gramme, livraison, codes promo. CBD Discounter n° 1 en 2026."
  else
    assign seo_title = page_title | append: ' | ' | append: brand
    assign seo_description = page_description
  endif
  assign og_url = canonical_url | default: request.origin
-%}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#12110f">
<title>{{ seo_title | strip_html | escape }}</title>
{%- if seo_description != blank -%}
  <meta name="description" content="{{ seo_description | strip_html | escape }}">
{%- endif -%}
<link rel="canonical" href="{{ canonical_url }}">
<meta property="og:site_name" content="{{ brand }}">
<meta property="og:locale" content="fr_FR">
<meta property="og:type" content="{% if template.name == 'index' %}article{% else %}website{% endif %}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ seo_title | strip_html | escape }}">
{%- if seo_description != blank -%}
  <meta property="og:description" content="{{ seo_description | strip_html | escape }}">
{%- endif -%}
{%- if page_image -%}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ seo_title | strip_html | escape }}">
{%- if seo_description != blank -%}
  <meta name="twitter:description" content="{{ seo_description | strip_html | escape }}">
{%- endif -%}
