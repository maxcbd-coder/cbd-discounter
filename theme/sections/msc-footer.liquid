<footer class="msc-footer">
  <div class="msc-footer__inner">
    <div class="msc-footer__grid">
      <div>
        <p class="msc-footer__logo">
          {{- section.settings.brand_before -}}
          <span>{{ section.settings.brand_mark }}</span>
          {{- section.settings.brand_after -}}
        </p>
        <p class="msc-footer__text">{{ section.settings.about }}</p>
      </div>
      <div>
        <p class="msc-footer__k">{{ section.settings.transparency_title }}</p>
        <p class="msc-footer__text msc-footer__text--wide">{{ section.settings.transparency_text }}</p>
      </div>
      <ul class="msc-footer__links">
        {%- if section.settings.legal_link != blank -%}
          <li><a href="{{ section.settings.legal_link }}">Mentions légales</a></li>
        {%- endif -%}
        {%- if section.settings.privacy_link != blank -%}
          <li><a href="{{ section.settings.privacy_link }}">Confidentialité</a></li>
        {%- endif -%}
        {%- if section.settings.contact_email != blank -%}
          <li><a href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a></li>
        {%- endif -%}
      </ul>
    </div>
    <div class="msc-footer__barcode" aria-hidden="true"></div>
    <p class="msc-footer__code" aria-hidden="true">{{ section.settings.barcode_number }}</p>
    <p class="msc-footer__legal">
      {{ section.settings.legal }} © {{ 'now' | date: '%Y' }}
      {{ section.settings.brand_before }}{{ section.settings.brand_mark }}{{ section.settings.brand_after }}
    </p>
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page",
  "tag": "div",
  "class": "msc-footer-section",
  "settings": [
    { "type": "text", "id": "brand_before", "label": "Logo — début", "default": "meilleurs-sites-cbd-" },
    { "type": "text", "id": "brand_mark", "label": "Logo — partie surlignée", "default": "pas-cher" },
    { "type": "text", "id": "brand_after", "label": "Logo — fin", "default": ".com" },
    { "type": "textarea", "id": "about", "label": "Présentation", "default": "Comparatif indépendant des prix du CBD en ligne en France. Prochain relevé des prix : mars 2027." },
    { "type": "text", "id": "transparency_title", "label": "Titre colonne 2", "default": "Transparence" },
    { "type": "textarea", "id": "transparency_text", "label": "Texte colonne 2", "default": "Seuls les trois sites du podium sont en lien. Certains liens peuvent être affiliés : cela ne change ni votre prix, ni le classement." },
    { "type": "text", "id": "legal_link", "label": "Lien « Mentions légales »", "default": "/policies/legal-notice" },
    { "type": "text", "id": "privacy_link", "label": "Lien « Confidentialité »", "default": "/policies/privacy-policy" },
    { "type": "text", "id": "contact_email", "label": "E-mail de contact", "default": "contact@meilleurs-sites-cbd-pas-cher.com" },
    { "type": "text", "id": "barcode_number", "label": "Numéro sous le code-barres", "default": "2 0 2 6 0 9 1 4 · 0 7 5" },
    { "type": "textarea", "id": "legal", "label": "Mention légale", "default": "Vente interdite aux mineurs. Les produits au CBD ne sont pas des médicaments. THC ≤ 0,3 %." }
  ]
}
{% endschema %}
