<footer class="msc-footer">
  <div class="msc-container msc-footer__top">
    <div class="msc-footer__cols">
      <p class="msc-footer__about">{{ section.settings.about }}</p>
      <ul class="msc-footer__links">
        {%- if section.settings.legal_link != blank -%}
          <li><a href="{{ section.settings.legal_link }}">Mentions légales</a></li>
        {%- endif -%}
        {%- if section.settings.privacy_link != blank -%}
          <li><a href="{{ section.settings.privacy_link }}">Confidentialité</a></li>
        {%- endif -%}
        {%- if section.settings.affiliation_link != blank -%}
          <li><a href="{{ section.settings.affiliation_link }}">Politique d'affiliation</a></li>
        {%- endif -%}
      </ul>
      <ul class="msc-footer__links">
        {%- if section.settings.contact_email != blank -%}
          <li><a href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a></li>
        {%- endif -%}
        {%- if section.settings.erratum_email != blank -%}
          <li><a href="mailto:{{ section.settings.erratum_email }}">Signaler une info erronée</a></li>
        {%- endif -%}
      </ul>
    </div>
    <p class="msc-wordmark" aria-hidden="true">{{ section.settings.wordmark }}</p>
  </div>
  <div class="msc-footer__bar">
    <div class="msc-container msc-footer__bar-inner">
      <p>{{ section.settings.disclaimer }}</p>
      <p>© {{ 'now' | date: '%Y' }} {{ section.settings.brand }}</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page Palmarès CBD",
  "tag": "div",
  "class": "msc-footer-section",
  "settings": [
    { "type": "text", "id": "brand", "label": "Nom du site", "default": "Palmarès CBD" },
    { "type": "textarea", "id": "about", "label": "Présentation", "default": "Palmarès CBD compare les boutiques en ligne de CBD en France. Dernier relevé : 14 septembre 2026." },
    { "type": "text", "id": "legal_link", "label": "Lien « Mentions légales »", "default": "/policies/legal-notice" },
    { "type": "text", "id": "privacy_link", "label": "Lien « Confidentialité »", "default": "/policies/privacy-policy" },
    { "type": "text", "id": "affiliation_link", "label": "Lien « Politique d'affiliation »", "default": "/#methode" },
    { "type": "text", "id": "contact_email", "label": "E-mail de contact", "default": "contact@palmares-cbd.fr" },
    { "type": "text", "id": "erratum_email", "label": "E-mail « Signaler une info erronée »", "default": "erratum@palmares-cbd.fr" },
    { "type": "text", "id": "wordmark", "label": "Wordmark géant", "default": "palmarès" },
    { "type": "textarea", "id": "disclaimer", "label": "Mention légale", "default": "Réservé aux personnes majeures. Les produits au CBD ne sont pas des médicaments et ne remplacent pas un avis médical. THC inférieur ou égal à 0,3 %." }
  ]
}
{% endschema %}
