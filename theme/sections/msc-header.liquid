<header class="msc-header">
  <div class="msc-header__inner">
    <a class="msc-logo" href="{{ routes.root_url }}#haut" aria-label="{{ section.settings.brand }} — accueil">
      <span class="msc-logo__diamond" aria-hidden="true"></span>
      <span class="msc-wordmark">{{ section.settings.brand }}<em> {{ section.settings.brand_accent }}</em></span>
    </a>
    <div class="msc-header__right">
      {%- if section.settings.date_label != blank -%}
        <span class="msc-header__date">{{ section.settings.date_label }}</span>
      {%- endif -%}
      <a class="msc-header__cta" href="{{ routes.root_url }}#classement">{{ section.settings.cta_label }}</a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "En-tête Meilleur site CBD",
  "tag": "div",
  "class": "msc-header-section",
  "settings": [
    { "type": "text", "id": "brand", "label": "Marque", "default": "Meilleur site" },
    { "type": "text", "id": "brand_accent", "label": "Marque — partie en italique doré", "default": "CBD" },
    { "type": "text", "id": "date_label", "label": "Mention de mise à jour", "default": "Mis à jour le 14 septembre 2026" },
    { "type": "text", "id": "cta_label", "label": "Bouton", "default": "Le classement" }
  ]
}
{% endschema %}
