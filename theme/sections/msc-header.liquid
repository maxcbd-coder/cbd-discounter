{%- liquid
  assign home = routes.root_url
  if template.name == 'index'
    assign home = ''
  endif
-%}
<div class="msc-topbar">
  <p>
    <span>{{ section.settings.survey_left }}</span>
    <span>{{ section.settings.survey_right }}</span>
  </p>
</div>
<header class="msc-header">
  <div class="msc-header__inner">
    <a class="msc-logo" href="{{ home }}#ticket">
      {{- section.settings.brand_before -}}
      <span class="msc-logo__mark">{{ section.settings.brand_mark }}</span>
      {{- section.settings.brand_after -}}
    </a>
    <nav class="msc-nav" aria-label="Sections">
      <a href="{{ home }}#simulateur">Simulateur</a>
      <a href="{{ home }}#rayon">Le rayon</a>
      <a href="{{ home }}#avis">Avis</a>
      <a href="{{ home }}#guide">Guide</a>
      <a href="{{ home }}#faq">FAQ</a>
      {%- if section.settings.cta_url != blank -%}
        <a class="msc-nav__cta" href="{{ section.settings.cta_url }}" rel="nofollow sponsored">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </nav>
  </div>
</header>

{% schema %}
{
  "name": "En-tête",
  "tag": "div",
  "class": "msc-header-section",
  "settings": [
    { "type": "header", "content": "Bandeau de relevé" },
    { "type": "text", "id": "survey_left", "label": "Texte gauche", "default": "Relevé des prix du 14 septembre 2026" },
    { "type": "text", "id": "survey_right", "label": "Texte droit", "default": "Prix au gramme TTC · hors frais de port" },
    { "type": "header", "content": "Logo texte" },
    { "type": "text", "id": "brand_before", "label": "Début", "default": "meilleurs-sites-cbd-" },
    { "type": "text", "id": "brand_mark", "label": "Partie surlignée en jaune", "default": "pas-cher" },
    { "type": "text", "id": "brand_after", "label": "Fin", "default": ".com" },
    { "type": "header", "content": "Bouton" },
    { "type": "text", "id": "cta_label", "label": "Texte", "default": "DISCOUNTER15 →" },
    { "type": "text", "id": "cta_url", "label": "Lien (nofollow sponsored)", "default": "https://www.cbd-discounter.fr/" }
  ]
}
{% endschema %}
