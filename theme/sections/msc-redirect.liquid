{%- comment -%}
  Remplace les gabarits marchands (produit, collection, panier, recherche, blog).
  La redirection est faite dans layout/landing.liquid ; ceci n'est qu'un repli sans JavaScript.
{%- endcomment -%}
<section class="msc-page">
  <div class="msc-wrap">
    <h1 class="msc-h2">{{ section.settings.title }}</h1>
    <p class="msc-page__back"><a class="msc-btn-ink" href="{{ routes.root_url }}">{{ section.settings.back_label }}</a></p>
  </div>
</section>

{% schema %}
{
  "name": "Redirection accueil",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Cette page n'est pas disponible" },
    { "type": "text", "id": "back_label", "label": "Bouton", "default": "Retour au comparatif →" }
  ]
}
{% endschema %}
