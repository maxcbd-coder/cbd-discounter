{%- comment -%}
  meilleurs-sites-cbd-pas-cher — one-page « Meilleur site CBD pas cher en 2026 » (V4, ticket de caisse).
  Contenu éditable : réglages de la section + blocs « Boutique » (ordre = rang), « Règle » (guide) et « Question » (FAQ).
  Règles : seules les 3 premières boutiques ont un lien externe (nofollow sponsored), un prix et un code ;
  le simulateur ne compare que le podium ; les JSON-LD sont générés depuis ces mêmes blocs.
{%- endcomment -%}

{%- liquid
  assign shops = section.blocks | where: 'type', 'shop'
  assign rules = section.blocks | where: 'type', 'rule'
  assign faqs = section.blocks | where: 'type', 'faq'
  assign top = shops | first
  assign nc = section.settings.nc_label
  assign cbd_name = top.settings.name
  assign cbd_link = '<a class="msc-cbdd" href="' | append: top.settings.url | append: '" rel="nofollow sponsored">' | append: cbd_name | append: '</a>'

  assign qtys = section.settings.sim_qtys | remove: ' ' | split: ','
  assign qty = section.settings.sim_default

  comment
    Prix du podium en centimes, liste « c1,c2,c3 », et total max pour la largeur des barres.
  endcomment
  assign podium_cents = ''
  assign max_total = 0
  for shop in shops limit: 3
    assign p = shop.settings.price | replace: ',', '.' | strip
    assign c = p | times: 100 | round
    assign podium_cents = podium_cents | append: c | append: ','
    assign t = c | times: qty
    if t > max_total
      assign max_total = t
    endif
  endfor
  assign podium_cents = podium_cents | split: ','
  if max_total == 0
    assign max_total = 1
  endif

  assign top_cents = podium_cents[0] | plus: 0
  assign top_eur = top_cents | divided_by: 100
  assign top_rest = top_cents | modulo: 100
  if top_rest < 10
    assign top_rest = '0' | append: top_rest
  endif
-%}

<div class="msc">
  {%- comment -%} ===== 2.3 Hero ===== {%- endcomment -%}
  <section id="ticket" class="msc-hero" aria-labelledby="h1">
    <div class="msc-hero__inner">
      <div>
        <p class="msc-label">{{ section.settings.hero_kicker }}</p>
        <h1 id="h1" class="msc-h1">
          {{- section.settings.hero_title_before }} <span class="msc-h1__mark">{{ section.settings.hero_title_mark }}</span> {{ section.settings.hero_title_after -}}
        </h1>
        <div class="msc-hero__intro"><p>{{ section.settings.hero_intro | replace: cbd_name, cbd_link }}</p></div>

        {%- if top -%}
          <div class="msc-hero__ctas">
            <a class="msc-tag" href="{{ top.settings.url }}" rel="nofollow sponsored" {{ top.shopify_attributes }}>
              <span class="msc-tag__hole" aria-hidden="true"></span>
              <span class="msc-tag__top">{{ top.settings.name }}{{ section.settings.tag_suffix }}</span>
              <span class="msc-tag__price">{{ top_eur }},{{ top_rest }}€<small>/g</small></span>
            </a>
            <div class="msc-hero__links">
              <a class="msc-btn-light" href="{{ top.settings.url }}" rel="nofollow sponsored">{{ section.settings.hero_cta_label }}</a>
              <a class="msc-hero__calc" href="#simulateur">{{ section.settings.hero_calc_label }}</a>
            </div>
          </div>
        {%- endif -%}
      </div>

      <figure class="msc-ticket">
        <div class="msc-ticket__body">
          <p class="msc-ticket__title">{{ section.settings.ticket_title }}</p>
          <p class="msc-ticket__sub">{{ section.settings.ticket_number }}</p>
          <p class="msc-ticket__rule msc-ticket__rule--a" aria-hidden="true">- - - - - - - - - - - - - - - - - - - - - - - - - - - - - -</p>
          {%- for shop in shops limit: 3 -%}
            <div class="msc-ticket__line{% if forloop.first %} msc-ticket__line--top{% endif %}">
              <span>0{{ forloop.index }}</span>
              <span class="msc-ticket__dots">{{ shop.settings.name | replace: cbd_name, cbd_link }} ................................................</span>
              <span class="msc-ticket__entry">{% render 'msc-eur', cents: podium_cents[forloop.index0], suffix: ' €/G' %}</span>
            </div>
          {%- endfor -%}
          <p class="msc-ticket__rule msc-ticket__rule--b" aria-hidden="true">- - - - - - - - - - - - - - - - - - - - - - - - - - - - - -</p>
          <div class="msc-ticket__kv">
            <div><span>{{ section.settings.ticket_best_label }}</span><strong class="msc-up">{{ cbd_link }}</strong></div>
            <div><span>{{ section.settings.ticket_ship_label }}</span><strong>{{ section.settings.ticket_ship_value }}</strong></div>
            <div><span>{{ section.settings.ticket_code_label }}</span><strong class="msc-ticket__code">{{ top.settings.promo }}</strong></div>
          </div>
          <p class="msc-ticket__rule msc-ticket__rule--c" aria-hidden="true">= = = = = = = = = = = = = = = = = = = = = = = = = = = = = =</p>
          <div class="msc-ticket__barcode" aria-hidden="true"></div>
          <p class="msc-ticket__foot">{{ section.settings.ticket_footer }}</p>
        </div>
        <div class="msc-ticket__tear" aria-hidden="true"></div>
        <figcaption class="msc-sr">
          Prix d'appel au gramme des trois sites du podium :
          {%- for shop in shops limit: 3 %} {{ shop.settings.name }} {% render 'msc-eur', cents: podium_cents[forloop.index0] %}{% if forloop.last %}.{% else %},{% endif %}{% endfor %}
        </figcaption>
      </figure>
    </div>
  </section>

  {%- comment -%} ===== 2.4 Verdict ===== {%- endcomment -%}
  <section class="msc-verdict" aria-label="Le verdict en bref">
    <ul>
      {%- for i in (1..3) -%}
        {%- assign k = 'verdict_' | append: i | append: '_k' -%}
        {%- assign v = 'verdict_' | append: i | append: '_v' -%}
        <li><span class="msc-verdict__k">{{ section.settings[k] }}</span><span class="msc-verdict__v">{{ section.settings[v] | replace: cbd_name, cbd_link }}</span></li>
      {%- endfor -%}
    </ul>
  </section>

  {%- comment -%} ===== 2.5 Simulateur ===== {%- endcomment -%}
  <section id="simulateur" class="msc-section" aria-labelledby="h-sim">
    <div class="msc-wrap">
      <div class="msc-sim__head">
        <div>
          <p class="msc-label">{{ section.settings.sim_kicker }}</p>
          <h2 id="h-sim" class="msc-h2">{{ section.settings.sim_title }}</h2>
        </div>
        <p class="msc-sim__intro">{{ section.settings.sim_intro | replace: cbd_name, cbd_link }}</p>
      </div>

      <div class="msc-sim" data-msc-sim>
        <div class="msc-sim__qty" role="group" aria-label="Quantité">
          <span class="msc-sim__qty-label">Quantité</span>
          {%- for q in qtys -%}
            {%- assign qn = q | plus: 0 -%}
            <button type="button" class="msc-sim__btn" data-msc-qty="{{ qn }}" aria-pressed="{% if qn == qty %}true{% else %}false{% endif %}">{{ qn }} g</button>
          {%- endfor -%}
        </div>
        <div class="msc-sim__bars" aria-live="polite">
          {%- for shop in shops limit: 3 -%}
            {%- liquid
              assign c = podium_cents[forloop.index0] | plus: 0
              assign t = c | times: qty
              assign w = t | times: 100.0 | divided_by: max_total | at_least: 2
            -%}
            <div class="msc-sim__row" data-msc-row data-cents="{{ c }}" data-name="{{ shop.settings.name | escape }}">
              <p class="msc-sim__name"><strong>{{ shop.settings.name | replace: cbd_name, cbd_link }}</strong><span>{% render 'msc-eur', cents: c, suffix: ' €/g' %}</span></p>
              <div class="msc-sim__track">
                <div class="msc-sim__bar{% if forloop.first %} msc-sim__bar--best{% endif %}" data-msc-bar style="width: {{ w }}%;"></div>
                <span class="msc-sim__total" data-msc-total>{% render 'msc-eur', cents: t %}</span>
              </div>
            </div>
          {%- endfor -%}
        </div>
        <div class="msc-sim__foot">
          {%- if shops.size >= 3 -%}
            {%- liquid
              assign s1 = shops[0]
              assign s2 = shops[1]
              assign s3 = shops[2]
              assign t1 = podium_cents[0] | times: qty
              assign d2 = podium_cents[1] | times: qty | minus: t1
              assign d3 = podium_cents[2] | times: qty | minus: t1
            -%}
            <p class="msc-sim__saving">Pour <span data-msc-q>{{ qty }}</span> g, {{ s1.settings.name | replace: cbd_name, cbd_link }} vous fait économiser <span data-msc-d="1">{% render 'msc-eur', cents: d2 %}</span> par rapport à {{ s2.settings.name }} et <span data-msc-d="2">{% render 'msc-eur', cents: d3 %}</span> par rapport à {{ s3.settings.name }}.</p>
          {%- endif -%}
          {%- if top -%}
            <a class="msc-btn-ink" href="{{ top.settings.url }}" rel="nofollow sponsored">{{ section.settings.sim_cta_label }}</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ===== 2.6 Le rayon ===== {%- endcomment -%}
  <section id="rayon" class="msc-section msc-rayon" aria-labelledby="h-rayon">
    <div class="msc-wrap">
      <p class="msc-label">{{ section.settings.rayon_kicker }}</p>
      <h2 id="h-rayon" class="msc-h2">{{ section.settings.rayon_title }}</h2>
      <p class="msc-rayon__intro">{{ section.settings.rayon_intro | replace: cbd_name, cbd_link }}</p>

      <ol class="msc-podium">
        {%- for shop in shops limit: 3 -%}
          {%- liquid
            assign c = podium_cents[forloop.index0] | plus: 0
            assign e = c | divided_by: 100
            assign r = c | modulo: 100
            if r < 10
              assign r = '0' | append: r
            endif
          -%}
          <li id="etiquette-{{ forloop.index }}" class="msc-label-card{% if forloop.first %} msc-label-card--top{% endif %}" {{ shop.shopify_attributes }}>
            {%- if forloop.first -%}
              <span class="msc-star" aria-hidden="true">{{ section.settings.star_label | replace: ' ', '<br>' }}</span>
            {%- endif -%}
            <div class="msc-label-card__band"><span>N° {{ forloop.index }} du classement</span></div>
            <div class="msc-label-card__body">
              <h3>{{ shop.settings.name | replace: cbd_name, cbd_link }}</h3>
              <p class="msc-price" aria-label="{{ e }},{{ r }} € le gramme">
                <span class="msc-price__eur" aria-hidden="true">{{ e }}</span>
                <span class="msc-price__side" aria-hidden="true"><span class="msc-price__cents">,{{ r }}€</span><span class="msc-price__unit">le gramme</span></span>
              </p>
              <dl>
                <dt>Livraison</dt><dd>{{ shop.settings.shipping }}</dd>
                <dt>Atout</dt><dd>{{ shop.settings.spec }}</dd>
                <dt>Code</dt><dd class="msc-mono">{{ shop.settings.promo }}</dd>
              </dl>
              {%- if shop.settings.url != blank -%}
                <a class="msc-label-card__cta" href="{{ shop.settings.url }}" rel="nofollow sponsored">Voir le site →</a>
              {%- endif -%}
            </div>
            <div class="msc-label-card__barcode" aria-hidden="true"></div>
          </li>
        {%- endfor -%}
      </ol>

      {%- if shops.size > 3 -%}
        <div class="msc-rest">
          <p class="msc-rest__head">{{ section.settings.rest_title }}</p>
          <ol start="4">
            {%- for shop in shops offset: 3 -%}
              {%- assign rank = forloop.index | plus: 3 -%}
              <li {{ shop.shopify_attributes }}>
                <span class="msc-rest__rank">{% if rank < 10 %}0{% endif %}{{ rank }}</span>
                <p class="msc-rest__main"><a class="msc-rest__name" href="#avis-{{ rank }}">{{ shop.settings.name }}</a><span class="msc-rest__spec">{{ shop.settings.spec }}</span></p>
                <p class="msc-rest__meta">Livraison : {{ shop.settings.shipping | default: nc }} · {{ shop.settings.domain }}</p>
              </li>
            {%- endfor -%}
          </ol>
        </div>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} ===== 2.7 Avis détaillés ===== {%- endcomment -%}
  <section id="avis" class="msc-section msc-avis" aria-labelledby="h-avis">
    <div class="msc-wrap">
      <p class="msc-label">{{ section.settings.avis_kicker }}</p>
      <h2 id="h-avis" class="msc-h2">{{ section.settings.avis_title }}</h2>
      {%- for shop in shops -%}
        {%- liquid
          assign rank = forloop.index
          assign is_podium = false
          if rank <= 3
            assign is_podium = true
          endif
          assign paras = shop.settings.body | newline_to_br | split: '<br />'
          assign plus = shop.settings.plus | newline_to_br | split: '<br />'
          assign minus = shop.settings.minus | newline_to_br | split: '<br />'
        -%}
        <article id="avis-{{ rank }}" class="msc-review{% if rank == 1 %} msc-review--top{% endif %}" {{ shop.shopify_attributes }}>
          <div class="msc-review__side">
            <p class="msc-review__chips">
              <span class="msc-chip">N° {% if rank < 10 %}0{% endif %}{{ rank }}</span>
              {%- if rank == 1 and section.settings.top_badge != blank -%}
                <span class="msc-chip msc-chip--best">{{ section.settings.top_badge }}</span>
              {%- endif -%}
            </p>
            <h3>{{ shop.settings.name | replace: cbd_name, cbd_link }}</h3>
            <p class="msc-review__dek">{{ shop.settings.dek | replace: cbd_name, cbd_link }}</p>
            <dl class="msc-review__data">
              <dt>Prix dès</dt>
              <dd>
                {%- if is_podium and shop.settings.price != blank -%}
                  {% render 'msc-eur', cents: podium_cents[forloop.index0], suffix: ' €/g' %}
                {%- else -%}
                  {{ nc }}
                {%- endif -%}
              </dd>
              <dt>Livraison</dt><dd>{{ shop.settings.shipping | default: nc }}</dd>
              <dt>Code</dt><dd>{% if is_podium and shop.settings.promo != blank %}{{ shop.settings.promo }}{% else %}—{% endif %}</dd>
              <dt>Site</dt><dd>{{ shop.settings.domain }}</dd>
            </dl>
            {%- if is_podium and shop.settings.url != blank -%}
              <a class="msc-btn-green" href="{{ shop.settings.url }}" rel="nofollow sponsored">Visiter {{ shop.settings.name }} →</a>
            {%- endif -%}
          </div>
          <div class="msc-review__main">
            {%- for t in paras -%}
              {%- assign t = t | strip -%}
              {%- if t != blank -%}<p>{{ t | replace: cbd_name, cbd_link }}</p>{%- endif -%}
            {%- endfor -%}
            <div class="msc-review__boxes">
              <div class="msc-box msc-box--plus">
                <h4>+ Les plus</h4>
                <ul>
                  {%- for x in plus -%}{%- assign x = x | strip -%}{%- if x != blank -%}<li>{{ x | replace: cbd_name, cbd_link }}</li>{%- endif -%}{%- endfor -%}
                </ul>
              </div>
              <div class="msc-box">
                <h4>− Les moins</h4>
                <ul>
                  {%- for x in minus -%}{%- assign x = x | strip -%}{%- if x != blank -%}<li>{{ x | replace: cbd_name, cbd_link }}</li>{%- endif -%}{%- endfor -%}
                </ul>
              </div>
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </section>

  {%- comment -%} ===== 2.8 Guide ===== {%- endcomment -%}
  <section id="guide" class="msc-section msc-guide" aria-labelledby="h-guide">
    <div class="msc-wrap">
      <p class="msc-label msc-label--yellow">{{ section.settings.guide_kicker }}</p>
      <h2 id="h-guide" class="msc-h2">{{ section.settings.guide_title }}</h2>
      <p class="msc-guide__intro">{{ section.settings.guide_intro | replace: cbd_name, cbd_link }}</p>

      <div class="msc-formula">
        <span class="msc-formula__box msc-formula__box--first">{{ section.settings.formula_1 }}</span>
        <span class="msc-formula__op" aria-hidden="true">×</span>
        <span class="msc-formula__box">{{ section.settings.formula_2 }}</span>
        <span class="msc-formula__op" aria-hidden="true">+</span>
        <span class="msc-formula__box">{{ section.settings.formula_3 }}</span>
        <span class="msc-formula__op" aria-hidden="true">−</span>
        <span class="msc-formula__box">{{ section.settings.formula_4 }}</span>
        <span class="msc-formula__op" aria-hidden="true">=</span>
        <span class="msc-formula__box msc-formula__box--result">{{ section.settings.formula_5 }}</span>
      </div>

      <ol class="msc-rules">
        {%- for rule in rules -%}
          <li {{ rule.shopify_attributes }}>
            <span class="msc-rules__n">RÈGLE {% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
            <h3>{{ rule.settings.title }}</h3>
            <p>{{ rule.settings.text | replace: cbd_name, cbd_link }}</p>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </section>

  {%- comment -%} ===== 2.9 FAQ (toujours ouverte) ===== {%- endcomment -%}
  <section id="faq" class="msc-section msc-faq" aria-labelledby="h-faq">
    <div class="msc-wrap">
      <p class="msc-label">{{ section.settings.faq_kicker }}</p>
      <h2 id="h-faq" class="msc-h2">{{ section.settings.faq_title }}</h2>
      <div class="msc-faq__grid">
        {%- for faq in faqs -%}
          <div class="msc-faq__item" {{ faq.shopify_attributes }}>
            <h3><span class="msc-faq__num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span><span>{{ faq.settings.q }}</span></h3>
            <p>{{ faq.settings.a | replace: cbd_name, cbd_link }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{%- liquid
  assign site_url = shop.url | append: '/'
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": {{ section.settings.site_name | json }},
    "url": {{ site_url | json }},
    "inLanguage": "fr-FR",
    "description": {{ section.settings.site_description | json }}
  }
</script>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": {{ section.settings.itemlist_name | json }},
    "numberOfItems": {{ shops.size }},
    "itemListOrder": "https://schema.org/ItemListOrderDescending",
    "itemListElement": [
      {%- for shop in shops -%}
        {%- liquid
          if forloop.index <= 3 and shop.settings.url != blank
            assign item_url = shop.settings.url
          else
            assign item_url = site_url | append: '#avis-' | append: forloop.index
          endif
        -%}
        {"@type": "ListItem", "position": {{ forloop.index }}, "name": {{ shop.settings.name | json }}, "url": {{ item_url | json }}}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for faq in faqs -%}
        {"@type": "Question", "name": {{ faq.settings.q | json }}, "acceptedAnswer": {"@type": "Answer", "text": {{ faq.settings.a | json }}}}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "Comparatif des prix",
  "tag": "div",
  "class": "msc-landing-section",
  "max_blocks": 40,
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_kicker", "label": "Libellé", "default": "Comparatif des prix · 10 boutiques · édition 2026" },
    { "type": "text", "id": "hero_title_before", "label": "Titre H1 — début", "default": "Meilleur site CBD" },
    { "type": "text", "id": "hero_title_mark", "label": "Titre H1 — partie surlignée", "default": "pas cher" },
    { "type": "text", "id": "hero_title_after", "label": "Titre H1 — fin", "default": "en 2026" },
    { "type": "inline_richtext", "id": "hero_intro", "label": "Chapô", "default": "Nous avons relevé les prix au gramme de dix boutiques CBD françaises. Le moins cher du podium s'appelle <strong>CBD Discounter</strong> : 0,75 € le gramme, et des colis expédiés le jour même." },
    { "type": "text", "id": "tag_suffix", "label": "Étiquette — texte après le nom du n°1", "default": " · dès" },
    { "type": "text", "id": "hero_cta_label", "label": "Bouton principal", "default": "Voir les prix CBD Discounter" },
    { "type": "text", "id": "hero_calc_label", "label": "Lien simulateur", "default": "Calculer mon panier ↓" },
    { "type": "header", "content": "Ticket" },
    { "type": "text", "id": "ticket_title", "label": "En-tête", "default": "MEILLEURS-SITES-CBD-PAS-CHER.COM" },
    { "type": "text", "id": "ticket_number", "label": "Sous-titre", "default": "Ticket n° 2026-0914 · comparatif des prix" },
    { "type": "text", "id": "ticket_best_label", "label": "Ligne 1 — libellé", "default": "MEILLEUR PRIX PODIUM" },
    { "type": "text", "id": "ticket_ship_label", "label": "Ligne 2 — libellé", "default": "EXPÉDITION" },
    { "type": "text", "id": "ticket_ship_value", "label": "Ligne 2 — valeur", "default": "JOUR MÊME <14H30" },
    { "type": "text", "id": "ticket_code_label", "label": "Ligne 3 — libellé", "default": "CODE N°1" },
    { "type": "text", "id": "ticket_footer", "label": "Pied du ticket", "default": "Merci de votre visite · prix relevés le 14/09/2026" },
    { "type": "header", "content": "Bandeau verdict" },
    { "type": "text", "id": "verdict_1_k", "label": "Cellule 1 — libellé", "default": "Prix le plus bas du podium" },
    { "type": "text", "id": "verdict_1_v", "label": "Cellule 1 — valeur", "default": "CBD Discounter, 0,75 €/g" },
    { "type": "text", "id": "verdict_2_k", "label": "Cellule 2 — libellé", "default": "Seul envoi le jour même" },
    { "type": "text", "id": "verdict_2_v", "label": "Cellule 2 — valeur", "default": "CBD Discounter, avant 14h30" },
    { "type": "text", "id": "verdict_3_k", "label": "Cellule 3 — libellé", "default": "Code à utiliser" },
    { "type": "text", "id": "verdict_3_v", "label": "Cellule 3 — valeur", "default": "DISCOUNTER15" },
    { "type": "header", "content": "Simulateur" },
