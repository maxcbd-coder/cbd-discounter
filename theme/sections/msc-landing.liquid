{%- comment -%}
  ActuCBD — landing « Les 10 meilleurs sites pour acheter du CBD ».
  Le contenu vient des blocs : shop (ordre = rang), pick, need, weight, tip, alert, faq.
  Liens : un bloc shop n'a un lien externe que si « url » est rempli.
  « dofollow » coché → rel="noopener" ; sinon rel="nofollow sponsored noopener".
  « Lier chaque mention » coché → chaque occurrence du nom dans les textes devient un lien (snippet msc-autolink).
{%- endcomment -%}

{%- liquid
  assign shops = section.blocks | where: 'type', 'shop'
  assign picks = section.blocks | where: 'type', 'pick'
  assign weights = section.blocks | where: 'type', 'weight'
  assign tips = section.blocks | where: 'type', 'tip'
  assign alerts = section.blocks | where: 'type', 'alert'
  assign needs = section.blocks | where: 'type', 'need'
  assign faqs = section.blocks | where: 'type', 'faq'
  assign top = shops | first
  assign romans = 'I,II,III,IV,V,VI,VII,VIII,IX,X' | split: ','
  assign shop_count = shops.size
-%}

<div class="msc">
  {%- comment -%} ===== Hero ===== {%- endcomment -%}
  <section id="haut" class="msc-hero" aria-labelledby="msc-h1">
    <span class="msc-hero__ghost" aria-hidden="true">{{ shop_count }}</span>
    <div class="msc-container msc-hero__inner">
      <p class="msc-kicker">{{ section.settings.hero_kicker }}</p>
      <h1 id="msc-h1" class="msc-h1">{{ section.settings.hero_title }}</h1>
      <p class="msc-hero__sub">{{ section.settings.hero_sub }}</p>
      <p class="msc-byline">
        {{ section.settings.byline }}
        {%- if section.settings.published_label != blank %} · Publié le <time datetime="{{ section.settings.published_iso }}">{{ section.settings.published_label }}</time>{% endif -%}
        {%- if section.settings.update_label != blank %} · Mis à jour le <time datetime="{{ section.settings.update_iso }}">{{ section.settings.update_label }}</time>{% endif -%}
      </p>

      {%- if top -%}
        <div class="msc-plaque" {{ top.shopify_attributes }}>
          <span class="msc-plaque__label">{{ section.settings.plaque_label }}</span>
          <span class="msc-plaque__sep" aria-hidden="true"></span>
          {%- render 'msc-shop-logo', s: top.settings, size: 32, alt: '' -%}
          <span class="msc-plaque__name">{% render 'msc-autolink', text: top.settings.name, shops: shops %}</span>
          <a class="msc-plaque__detail" href="#rang-1">Dès {{ top.settings.entry }} — lire l'avis</a>
        </div>
      {%- endif -%}

      <div class="msc-hero__ctas">
        <a class="msc-btn msc-btn--champagne" href="#classement">Voir le classement complet</a>
        <a class="msc-btn msc-btn--ghost" href="#methodologie">Notre méthodologie</a>
      </div>

      <dl class="msc-stats">
        {%- for i in (1..4) -%}
          {%- assign label_key = 'stat_' | append: i | append: '_label' -%}
          {%- assign value_key = 'stat_' | append: i | append: '_value' -%}
          {%- if section.settings[label_key] != blank -%}
            <div>
              <dt>{{ section.settings[label_key] }}</dt>
              <dd>{{ section.settings[value_key] }}</dd>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </dl>
    </div>
  </section>

  {%- comment -%} ===== Sommaire ===== {%- endcomment -%}
  <nav class="msc-toc" aria-label="Sommaire">
    <div class="msc-container">
      <ol class="msc-toc__list">
        {%- if picks.size > 0 -%}<li><a href="#synthese">Synthèse</a></li>{%- endif -%}
        <li><a href="#comparatif">Comparatif</a></li>
        <li><a href="#classement">Classement</a></li>
        {%- if needs.size > 0 -%}<li><a href="#par-besoin">Selon votre besoin</a></li>{%- endif -%}
        <li><a href="#methodologie">Méthodologie</a></li>
        {%- if tips.size > 0 -%}<li><a href="#conseils">Conseils</a></li>{%- endif -%}
        {%- if alerts.size > 0 -%}<li><a href="#alertes">Signaux d'alerte</a></li>{%- endif -%}
        {%- if faqs.size > 0 -%}<li><a href="#faq">FAQ</a></li>{%- endif -%}
      </ol>
    </div>
  </nav>

  {%- comment -%} ===== Chapitre I — Synthèse ===== {%- endcomment -%}
  {%- if picks.size > 0 -%}
    <section id="synthese" class="msc-light msc-section" data-reveal aria-labelledby="synthese-titre">
      <div class="msc-container">
        <div class="msc-head">
          <h2 id="synthese-titre" class="msc-h2">{{ section.settings.synth_title }}</h2>
          <span class="msc-chapter">Chapitre I</span>
        </div>
        <div class="msc-picks">
          {%- for pick in picks -%}
            {%- liquid
              assign pick_shop = nil
              for sh in shops
                if sh.settings.name == pick.settings.shop
                  assign pick_shop = sh
                  break
                endif
              endfor
            -%}
            <article class="msc-pick" {{ pick.shopify_attributes }}>
              <p class="msc-pick__top">
                <span class="msc-pick__num">{{ romans[forloop.index0] }}</span>
                <span class="msc-pick__label">{{ pick.settings.label }}</span>
              </p>
              <p class="msc-pick__shop">
                {%- if pick_shop -%}{%- render 'msc-shop-logo', s: pick_shop.settings, size: 40, alt: '' -%}{%- endif -%}
                <span>{% render 'msc-autolink', text: pick.settings.shop, shops: shops %}</span>
              </p>
              <p class="msc-pick__price">
                <span class="msc-pick__note">{{ pick.settings.note }}</span>
                <span class="msc-pick__sep" aria-hidden="true"></span>
                {{- pick.settings.detail -}}
              </p>
              <p class="msc-pick__why">{% render 'msc-autolink', text: pick.settings.why, shops: shops %}</p>
            </article>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ===== Chapitre II — Tableau comparatif ===== {%- endcomment -%}
  <section id="comparatif" class="msc-dark msc-section" data-reveal aria-labelledby="tableau-titre">
    <div class="msc-container">
      <div class="msc-head msc-head--tight">
        <h2 id="tableau-titre" class="msc-h2">{{ section.settings.table_title }}</h2>
        <span class="msc-chapter">Chapitre II</span>
      </div>
      <p class="msc-lede">{{ section.settings.table_sub }}</p>

      <div class="msc-table-wrap">
        <table class="msc-table">
          <caption>{{ section.settings.table_caption }}</caption>
          <thead>
            <tr>
              <th scope="col">Rang</th>
              <th scope="col">Boutique</th>
              <th scope="col">Prix dès</th>
              <th scope="col">Livraison</th>
              <th scope="col">Code promo</th>
              <th scope="col">Spécificité</th>
              <th scope="col">Site</th>
            </tr>
          </thead>
          <tbody>
            {%- for shop in shops -%}
              {%- liquid
                assign s = shop.settings
                assign pad = forloop.index
                if forloop.index < 10
                  assign pad = '0' | append: forloop.index
                endif
                assign rel = 'nofollow sponsored noopener'
                if s.dofollow
                  assign rel = 'noopener'
                endif
              -%}
              <tr{% if forloop.first %} class="is-top"{% endif %}>
                <td class="msc-table__rank">{{ pad }}</td>
                <th scope="row">
                  <span class="msc-table__name">
                    {%- render 'msc-shop-logo', s: s, size: 36, alt: '' -%}
                    <span>{% render 'msc-autolink', text: s.name, shops: shops %}</span>
                    {%- if forloop.first -%}<span class="msc-badge">Notre choix</span>{%- endif -%}
                  </span>
                </th>
                <td class="msc-nowrap">{{ s.entry }}</td>
                <td>{{ s.shipping }}</td>
                <td>
                  {%- if s.promo != blank -%}
                    <span class="msc-promo">{{ s.promo }}</span>
                  {%- else -%}
                    <span class="msc-muted">—</span>
                  {%- endif -%}
                </td>
                <td>{{ s.spec }}</td>
                <td class="msc-table__site">
                  {%- if s.url != blank -%}
                    <a class="msc-btn msc-btn--outline" href="{{ s.url }}" rel="{{ rel }}" target="_blank">Voir le site</a>
                  {%- else -%}
                    <span class="msc-domain">{{ s.domain }}</span>
                  {%- endif -%}
                </td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>

      <ol class="msc-cards">
        {%- for shop in shops -%}
          {%- liquid
            assign s = shop.settings
            assign pad = forloop.index
            if forloop.index < 10
              assign pad = '0' | append: forloop.index
            endif
            assign rel = 'nofollow sponsored noopener'
            if s.dofollow
              assign rel = 'noopener'
            endif
          -%}
          <li class="msc-card{% if forloop.first %} is-top{% endif %}">
            <p class="msc-card__title">
              <span class="msc-card__rank">{{ pad }}</span>
              {%- render 'msc-shop-logo', s: s, size: 40, alt: '' -%}
              <span class="msc-card__name">{% render 'msc-autolink', text: s.name, shops: shops %}</span>
              {%- if forloop.first -%}<span class="msc-badge">Notre choix</span>{%- endif -%}
            </p>
            <dl>
              <dt>Spécificité</dt>
              <dd>{{ s.spec }}</dd>
              <dt>Prix dès</dt>
              <dd>{{ s.entry }}</dd>
              <dt>Livraison</dt>
              <dd>{{ s.shipping }}</dd>
              <dt>Code promo</dt>
              <dd class="msc-card__promo">{{ s.promo | default: '—' }}</dd>
            </dl>
            {%- if s.url != blank -%}
              <a class="msc-card__cta" href="{{ s.url }}" rel="{{ rel }}" target="_blank">Voir le site</a>
            {%- else -%}
              <p class="msc-card__domain">{{ s.domain }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </section>

  {%- comment -%} ===== Chapitre III — Classement détaillé ===== {%- endcomment -%}
  <section id="classement" class="msc-light msc-ranking" aria-labelledby="classement-titre">
    <div class="msc-container">
      <div class="msc-head msc-head--tight">
        <h2 id="classement-titre" class="msc-h2">{{ section.settings.ranking_title }}</h2>
        <span class="msc-chapter">Chapitre III</span>
      </div>
      <p class="msc-lede">{{ section.settings.ranking_sub }}</p>

      {%- for shop in shops -%}
        {%- liquid
          assign s = shop.settings
          assign pad = forloop.index
          if forloop.index < 10
            assign pad = '0' | append: forloop.index
          endif
          assign pros = s.pros | newline_to_br | split: '<br />'
          assign cons = s.cons | newline_to_br | split: '<br />'
          assign rel = 'nofollow sponsored noopener'
          if s.dofollow
            assign rel = 'noopener'
          endif
          assign logo_alt = 'Logo ' | append: s.name
        -%}
        <article id="rang-{{ forloop.index }}" class="msc-shop" data-reveal {{ shop.shopify_attributes }}>
          <div class="msc-shop__grid">
            <div class="msc-shop__rail">
              <span class="msc-shop__rank" aria-hidden="true">{{ pad }}</span>
              <div class="msc-shop__price">
                <span class="msc-shop__price-label">Prix dès</span>
                <span class="msc-shop__price-value">{{ s.entry }}</span>
              </div>
            </div>

            <div class="msc-shop__body">
              <div class="msc-shop__kicker">
                {%- if forloop.first -%}
                  <span class="msc-badge msc-badge--encre">{{ section.settings.top_badge }}</span>
                {%- endif -%}
                <p class="msc-shop__tagline">{{ s.tagline }}</p>
              </div>
              <div class="msc-shop__head">
                {%- render 'msc-shop-logo', s: s, size: 64, alt: logo_alt -%}
                <h2 class="msc-shop__name">{% render 'msc-autolink', text: s.name, shops: shops %}</h2>
              </div>

              <div class="msc-proscons">
                <div class="msc-pros">
                  <h3>Points forts</h3>
                  <ul>
                    {%- for line in pros -%}
                      {%- assign item = line | strip -%}
                      {%- if item != blank -%}
                        <li><span aria-hidden="true">+</span><span>{% render 'msc-autolink', text: item, shops: shops %}</span></li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                </div>
                <div class="msc-cons">
                  <h3>Points faibles</h3>
                  <ul>
                    {%- for line in cons -%}
                      {%- assign item = line | strip -%}
                      {%- if item != blank -%}
                        <li><span aria-hidden="true">−</span><span>{% render 'msc-autolink', text: item, shops: shops %}</span></li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                </div>
              </div>

              <table class="msc-facts">
                <caption>Informations relevées</caption>
                <tbody>
                  <tr>
                    <th scope="row">Prix dès</th>
                    <td>{{ s.entry }}</td>
                  </tr>
                  <tr>
                    <th scope="row">Livraison</th>
                    <td>{{ s.shipping }}</td>
                  </tr>
                  <tr>
                    <th scope="row">Code promo</th>
                    <td>{{ s.promo | default: '—' }}</td>
                  </tr>
                  <tr>
                    <th scope="row">Spécificité</th>
                    <td>{{ s.spec }}</td>
                  </tr>
                  <tr>
                    <th scope="row">Site</th>
                    <td>
                      {%- if s.url != blank and s.autolink -%}
                        <a class="msc-xlink" href="{{ s.url }}" rel="{{ rel }}" target="_blank">{{ s.domain }}</a>
                      {%- else -%}
                        {{ s.domain }}
                      {%- endif -%}
                    </td>
                  </tr>
                </tbody>
              </table>

              <p class="msc-shop__text">{% render 'msc-autolink', text: s.body, shops: shops %}</p>

              {%- if s.url != blank -%}
                <div class="msc-shop__actions">
                  <a class="msc-btn msc-btn--encre" href="{{ s.url }}" rel="{{ rel }}" target="_blank">Voir le site</a>
                  {%- if s.promo != blank -%}
                    <span class="msc-shop__code">Code<span>{{ s.promo }}</span></span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </section>

  {%- comment -%} ===== Verdict ===== {%- endcomment -%}
  {%- if top -%}
    <section class="msc-verdict" data-reveal aria-labelledby="verdict-titre">
      <div class="msc-container msc-verdict__grid">
        <div>
          <span class="msc-verdict__kicker">Le verdict de la rédaction</span>
          <h2 id="verdict-titre" class="msc-h2">Pourquoi <em>{% render 'msc-autolink', text: top.settings.name, shops: shops %}</em> arrive en tête</h2>
          <p class="msc-verdict__text">{% render 'msc-autolink', text: section.settings.verdict_text, shops: shops %}</p>
          {%- if top.settings.url != blank -%}
            {%- liquid
              assign rel = 'nofollow sponsored noopener'
              if top.settings.dofollow
                assign rel = 'noopener'
              endif
            -%}
            <a class="msc-btn msc-btn--noir" href="{{ top.settings.url }}" rel="{{ rel }}" target="_blank">Voir {{ top.settings.name }}</a>
          {%- endif -%}
        </div>
        <dl class="msc-verdict__facts">
          <div>
            <dt>Prix dès</dt>
            <dd>{{ top.settings.entry }}</dd>
          </div>
          <div>
            <dt>Catalogue</dt>
            <dd>{{ section.settings.verdict_catalogue }}</dd>
          </div>
          <div>
            <dt>Expédition</dt>
            <dd>{{ section.settings.verdict_shipping }}</dd>
          </div>
          {%- if top.settings.promo != blank -%}
            <div>
              <dt>Code promo</dt>
              <dd>{{ top.settings.promo }}</dd>
            </div>
          {%- endif -%}
        </dl>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ===== Chapitre IV — Selon votre besoin ===== {%- endcomment -%}
  {%- if needs.size > 0 -%}
    <section id="par-besoin" class="msc-light-2 msc-section" data-reveal aria-labelledby="besoin-titre">
      <div class="msc-container">
        <div class="msc-head msc-head--tight">
          <h2 id="besoin-titre" class="msc-h2">{{ section.settings.needs_title }}</h2>
          <span class="msc-chapter">Chapitre IV</span>
        </div>
        <p class="msc-lede">{{ section.settings.needs_sub }}</p>
        <ul class="msc-needs">
          {%- for need in needs -%}
            {%- liquid
              assign need_shop = nil
              assign need_rank = nil
              for sh in shops
                if sh.settings.name == need.settings.shop
                  assign need_shop = sh
                  assign need_rank = forloop.index
                  break
                endif
              endfor
            -%}
            <li class="msc-need" {{ need.shopify_attributes }}>
              <h3 class="msc-need__label">{{ need.settings.label }}</h3>
              <p class="msc-need__shop">
                {%- if need_shop -%}{%- render 'msc-shop-logo', s: need_shop.settings, size: 36, alt: '' -%}{%- endif -%}
                <span>{% render 'msc-autolink', text: need.settings.shop, shops: shops %}</span>
                {%- if need_rank -%}<a class="msc-need__rank" href="#rang-{{ need_rank }}">N° {{ need_rank }}</a>{%- endif -%}
              </p>
              <p class="msc-need__why">{% render 'msc-autolink', text: need.settings.why, shops: shops %}</p>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ===== Chapitre V — Méthodologie ===== {%- endcomment -%}
  <section id="methodologie" class="msc-dark msc-section" data-reveal aria-labelledby="methodologie-titre">
    <div class="msc-container msc-2col">
      <div>
        <span class="msc-chapter">Chapitre V</span>
        <h2 id="methodologie-titre" class="msc-h2">{{ section.settings.method_title }}</h2>
        <p class="msc-method__intro">{{ section.settings.method_intro }}</p>
        <div class="msc-transparency">
          <h3>Transparence sur les relations commerciales</h3>
          <p>{% render 'msc-autolink', text: section.settings.transparency_text, shops: shops %}</p>
        </div>
      </div>
      <ol class="msc-weights">
        {%- for weight in weights -%}
          <li class="msc-weight" {{ weight.shopify_attributes }}>
            <p class="msc-weight__name">{{ weight.settings.name }}</p>
            <p class="msc-weight__pct">{{ weight.settings.pct }} %</p>
            <div class="msc-weight__bar" aria-hidden="true">
              <span style="width: {{ weight.settings.bar }}%;"></span>
            </div>
            <p class="msc-weight__desc">{{ weight.settings.desc }}</p>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </section>

  {%- comment -%} ===== Chapitre VI — Conseils ===== {%- endcomment -%}
  {%- if tips.size > 0 -%}
    <section id="conseils" class="msc-light msc-section" data-reveal aria-labelledby="conseils-titre">
      <div class="msc-container">
        <div class="msc-head">
          <h2 id="conseils-titre" class="msc-h2">{{ section.settings.tips_title }}</h2>
          <span class="msc-chapter">Chapitre VI</span>
        </div>
        <ol class="msc-tips">
          {%- for tip in tips -%}
            <li class="msc-tip" {{ tip.shopify_attributes }}>
              <span class="msc-tip__num" aria-hidden="true">{{ forloop.index }}</span>
              <h3 class="msc-tip__title">{% render 'msc-autolink', text: tip.settings.title, shops: shops %}</h3>
              <p class="msc-tip__desc">{% render 'msc-autolink', text: tip.settings.desc, shops: shops %}</p>
            </li>
          {%- endfor -%}
        </ol>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ===== Chapitre VII — Signaux d'alerte ===== {%- endcomment -%}
  {%- if alerts.size > 0 -%}
    <section id="alertes" class="msc-light-2 msc-section" data-reveal aria-labelledby="alertes-titre">
      <div class="msc-container msc-2col">
        <div>
          <span class="msc-chapter">Chapitre VII</span>
          <h2 id="alertes-titre" class="msc-h2">{{ section.settings.alerts_title }}</h2>
          <p class="msc-alerts__intro">{{ section.settings.alerts_intro }}</p>
        </div>
        <ul class="msc-alerts">
          {%- for alert in alerts -%}
            <li class="msc-alert" {{ alert.shopify_attributes }}>
              <h3 class="msc-alert__title">{{ alert.settings.title }}</h3>
              <p class="msc-alert__desc">{% render 'msc-autolink', text: alert.settings.desc, shops: shops %}</p>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ===== Chapitre VIII — FAQ ===== {%- endcomment -%}
  {%- if faqs.size > 0 -%}
    <section id="faq" class="msc-dark msc-section" data-reveal aria-labelledby="faq-titre">
      <div class="msc-container msc-2col">
        <div>
          <span class="msc-chapter">Chapitre VIII</span>
          <h2 id="faq-titre" class="msc-h2">{{ section.settings.faq_title }}</h2>
        </div>
        <div class="msc-faq">
          {%- for faq in faqs -%}
            {%- liquid
              assign num = forloop.index
              if forloop.index < 10
                assign num = '0' | append: forloop.index
              endif
            -%}
            <div class="msc-faq__item" {{ faq.shopify_attributes }}>
              <h3 class="msc-faq__q">
                <button
                  type="button"
                  class="msc-faq__btn"
                  aria-expanded="false"
                  aria-controls="msc-faq-{{ faq.id }}"
                >
                  <span class="msc-faq__num">{{ num }}</span>
                  <span>{{ faq.settings.q }}</span>
                  <span class="msc-faq__sign" aria-hidden="true"></span>
                </button>
              </h3>
              <p id="msc-faq-{{ faq.id }}" class="msc-faq__a" hidden>{% render 'msc-autolink', text: faq.settings.a, shops: shops %}</p>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}
</div>

{%- comment -%} ===== Données structurées, générées depuis les mêmes blocs que le contenu visible ===== {%- endcomment -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": {{ request.origin | append: '/#organisation' | json }},
    "name": {{ section.settings.org_name | json }},
    {%- if section.settings.org_alternate != blank %}
    "alternateName": {{ section.settings.org_alternate | json }},
    {%- endif %}
    "url": {{ request.origin | append: '/' | json }},
    "description": {{ section.settings.org_description | json }},
    "areaServed": "FR"
  }
</script>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": {{ request.origin | append: '/#site' | json }},
    "name": {{ section.settings.org_name | json }},
    "url": {{ request.origin | append: '/' | json }},
    "inLanguage": "fr-FR",
    "publisher": {"@id": {{ request.origin | append: '/#organisation' | json }}}
  }
</script>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": {{ section.settings.itemlist_name | json }},
    "description": {{ section.settings.hero_sub | strip_html | json }},
    "inLanguage": "fr-FR",
    "datePublished": {{ section.settings.published_iso | json }},
    "dateModified": {{ section.settings.update_iso | json }},
    "mainEntityOfPage": {{ request.origin | append: '/' | json }},
    "author": {"@id": {{ request.origin | append: '/#organisation' | json }}},
    "publisher": {"@id": {{ request.origin | append: '/#organisation' | json }}}
  }
</script>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": {{ section.settings.itemlist_name | json }},
    "dateModified": {{ section.settings.update_iso | json }},
    "numberOfItems": {{ shop_count }},
    "itemListOrder": "https://schema.org/ItemListOrderDescending",
    "itemListElement": [
      {%- for shop in shops -%}
        {%- if shop.settings.url != blank -%}
          {%- assign item_url = shop.settings.url -%}
        {%- else -%}
          {%- assign item_url = request.origin | append: '/#rang-' | append: forloop.index -%}
        {%- endif -%}
        {"@type": "ListItem", "position": {{ forloop.index }}, "name": {{ shop.settings.name | json }}, "url": {{ item_url | json }}
          {%- if shop.settings.logo != blank -%}, "image": {{ shop.settings.logo | image_url: width: 256 | prepend: 'https:' | json }}{%- endif -%}
        }
        {%- unless forloop.last %},{% endunless -%}
      {%- endfor -%}
    ]
  }
</script>
{%- if faqs.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "dateModified": {{ section.settings.update_iso | json }},
      "mainEntity": [
        {%- for faq in faqs -%}
          {"@type": "Question", "name": {{ faq.settings.q | json }}, "acceptedAnswer": {"@type": "Answer", "text": {{ faq.settings.a | json }}}}
          {%- unless forloop.last %},{% endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

