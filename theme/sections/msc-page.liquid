{%- comment -%} Pages secondaires (mentions légales, 404) dans la charte de la landing. {%- endcomment -%}
<section class="msc-page">
  <div class="msc-container msc-section msc-page__inner">
    {%- if template.name == '404' -%}
      <h1 class="msc-page__title">{{ section.settings.not_found_title }}</h1>
      <div class="msc-rte"><p>{{ section.settings.not_found_text }}</p></div>
    {%- else -%}
      <h1 class="msc-page__title">{{ page.title }}</h1>
      <div class="msc-rte">{{ page.content }}</div>
    {%- endif -%}
    <p class="msc-page__actions"><a class="msc-hero__cta" href="{{ routes.root_url }}#classement">Voir le palmarès</a></p>
  </div>
</section>

{% schema %}
{
  "name": "Page Palmarès CBD",
  "settings": [
    { "type": "text", "id": "not_found_title", "label": "Titre 404", "default": "Page introuvable" },
    { "type": "textarea", "id": "not_found_text", "label": "Texte 404", "default": "Cette page n'existe pas ou n'est plus disponible. Retrouve le top 10 des meilleurs sites CBD en France." }
  ]
}
{% endschema %}
