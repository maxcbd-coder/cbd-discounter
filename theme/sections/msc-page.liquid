{%- comment -%} Pages (mentions légales, contact…) et 404 dans la charte de la landing. {%- endcomment -%}
<section class="msc-page">
  <div class="msc-wrap">
    {%- if template.name == '404' -%}
      <p class="msc-label">Erreur 404</p>
      <h1 class="msc-h2">{{ section.settings.not_found_title }}</h1>
      <div class="msc-rte"><p>{{ section.settings.not_found_text }}</p></div>
    {%- else -%}
      <h1 class="msc-h2">{{ page.title }}</h1>
      <div class="msc-rte">{{ page.content }}</div>
    {%- endif -%}
    <p class="msc-page__back"><a class="msc-btn-ink" href="{{ routes.root_url }}#rayon">{{ section.settings.back_label }}</a></p>
  </div>
</section>

{% schema %}
{
  "name": "Page",
  "settings": [
    { "type": "text", "id": "not_found_title", "label": "Titre 404", "default": "Page introuvable" },
    { "type": "textarea", "id": "not_found_text", "label": "Texte 404", "default": "Cette page n'existe pas ou n'est plus disponible. Retrouvez notre comparatif des prix du CBD sur la page d'accueil." },
    { "type": "text", "id": "back_label", "label": "Bouton retour", "default": "Voir le comparatif des prix →" }
  ]
}
{% endschema %}
