        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "q": "Le CBD est-il légal en France en 2026 ?",
            "a": "Oui. La vente et l'achat de produits au CBD sont autorisés en France lorsque le taux de THC du produit fini reste inférieur ou égal à 0,3 %. Exigez toujours le certificat d'analyse du lot pour le vérifier."
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "q": "Comment ce classement est-il établi ?",
            "a": "ActuCBD a testé 34 boutiques françaises entre janvier et août 2026 sur 6 critères pondérés : prix au gramme, taux de CBD et analyses, origine et traçabilité, livraison, paiement, service après-vente. Chaque commande a été passée et payée par la rédaction."
          }
        },
        "faq_4": {
          "type": "faq",
          "settings": {
            "q": "Les liens du classement sont-ils affiliés ?",
            "a": "Certains liens sont affiliés. ActuCBD perçoit une commission si un achat est réalisé, sans surcoût pour le lecteur. La commission n'influence ni la note ni le rang : les notes sont calculées avant toute prise de contact commerciale et la grille de pondération est publique."
          }
        },
        "faq_5": {
          "type": "faq",
          "settings": {
            "q": "Quel budget prévoir pour une première commande ?",
            "a": "Les prix de départ relevés vont de 0,34 € le gramme pour du trim chez CBDSol à 7,14 € le gramme chez CBDP Paris. CBD Discounter, numéro 1 du classement, propose des fleurs dès 0,75 € le gramme."
          }
        },
        "faq_6": {
          "type": "faq",
          "settings": {
            "q": "Comment vérifier le taux de CBD annoncé ?",
            "a": "Le certificat d'analyse doit indiquer le numéro de lot, la date d'analyse, le nom du laboratoire et les taux de CBD et de THC. Un certificat daté de plus de douze mois ou sans numéro de lot n'est pas exploitable."
          }
        },
        "faq_7": {
