{%- comment -%}
  Logo d'une boutique dans une tuile carrée. Sans image : monogramme.
  @param s     Réglages du bloc Boutique (block.settings)
  @param size  Taille en px (défaut 40)
  @param alt   Texte alternatif (vide = décoratif, le nom est affiché à côté)
{%- endcomment -%}
{%- liquid
  assign px = size | default: 40
  assign px2 = px | times: 2
  assign words = s.name | split: ' '
  assign initials = ''
  if words.size > 1
    for w in words limit: 2
      assign c = w | slice: 0 | upcase
      assign initials = initials | append: c
    endfor
  else
    assign initials = s.name | slice: 0, 2 | upcase
  endif
-%}
<span class="gz-logo{% if s.logo == blank %} gz-logo--mono{% endif %}" style="--gz-logo: {{ px }}px;">
  {%- if s.logo != blank -%}
    {{- s.logo | image_url: width: px2, height: px2, crop: 'center' | image_tag: width: px, height: px, loading: 'lazy', alt: alt, class: 'gz-logo__img' -}}
  {%- else -%}
    <span class="gz-logo__mono" aria-hidden="true">{{ initials }}</span>
  {%- endif -%}
</span>
