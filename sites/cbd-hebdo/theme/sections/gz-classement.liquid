{%- comment -%}
  Une seule source de données pour le podium, le relevé, les dix fiches et le face-à-face :
  les blocs « Boutique » (rang = ordre des blocs) et les blocs « Adversaire ».
  Liens externes et codes promo affichés pour les rangs 1 à 3 uniquement.
  « Lien dofollow » coché : rel="noopener" ; sinon rel="nofollow sponsored".
  Les mentions de boutique dans les textes passent par le snippet gz-autolink.
{%- endcomment -%}
{%- assign shops = section.blocks | where: 'type', 'shop' -%}
{%- assign rivals = section.blocks | where: 'type', 'rival' -%}
{%- assign champion = shops.first -%}

<section id="podium" class="gz-podium" aria-labelledby="titre-podium">
  <div class="gz-wrap">
    <div class="gz-podium__head">
      <h2 id="titre-podium" class="gz-h2">{{ section.settings.podium_title | escape }}</h2>
      <p class="gz-podium__intro">{{ section.settings.podium_intro | escape }}</p>
    </div>
    <div class="gz-podium__grid">
      {%- for s in shops limit: 3 -%}
        {%- if s.settings.dofollow -%}{%- assign rel = 'noopener' -%}{%- else -%}{%- assign rel = 'nofollow sponsored' -%}{%- endif -%}
        <article class="gz-sachet gz-sachet--{{ forloop.index }}" {{ s.shopify_attributes }}>
          <div class="gz-sachet__perf" aria-hidden="true"></div>
          <div class="gz-sachet__body">
            <div class="gz-sachet__top">
              <p class="gz-sachet__meta">Sachet n°{{ forloop.index }}<br>Contient : {{ s.settings.contains | escape }}</p>
              <span class="gz-sachet__num">{{ forloop.index }}</span>
            </div>
            <div class="gz-shop-id">
              {%- render 'gz-shop-logo', s: s.settings, size: 48, alt: '' -%}
              <h3 class="gz-sachet__name">{% render 'gz-autolink', text: s.settings.name %}</h3>
            </div>
            <p class="gz-sachet__line">{% render 'gz-autolink', text: s.settings.line %}</p>
            <dl class="gz-sachet__data">
              <dt>Prix dès</dt><dd>{{ s.settings.entry | escape }}</dd>
              <dt>Livraison</dt><dd>{{ s.settings.shipping | escape }}</dd>
              <dt>Code</dt><dd>{% if s.settings.promo != blank %}{{ s.settings.promo | escape }}{% else %}—{% endif %}</dd>
            </dl>
            {%- if s.settings.url != blank -%}
              <a class="gz-btn gz-sachet__cta" href="{{ s.settings.url }}" rel="{{ rel }}" target="_blank">Visiter {{ s.settings.name | escape }} →</a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

<section id="releve" class="gz-wrap" aria-labelledby="titre-releve">
  <p class="gz-kicker">{{ section.settings.releve_kicker | escape }}</p>
  <h2 id="titre-releve" class="gz-h2 gz-releve__title">{{ section.settings.releve_title | escape }}</h2>
  <p class="gz-releve__intro">{{ section.settings.releve_intro | escape }}</p>

  <div class="gz-table-wrap">
    <table class="gz-table">
      <caption class="gz-visually-hidden">{{ section.settings.releve_caption | escape }}</caption>
      <thead>
        <tr>
          <th scope="col">N°</th>
          <th scope="col">Boutique</th>
          <th scope="col">Prix dès</th>
          <th scope="col">Livraison</th>
          <th scope="col">Code promo</th>
          <th scope="col">Spécificité</th>
          <th scope="col">Site</th>
        </tr>
      </thead>
      <tbody>
        {%- for s in shops -%}
          {%- assign rank = forloop.index -%}
          {%- if s.settings.dofollow -%}{%- assign rel = 'noopener' -%}{%- else -%}{%- assign rel = 'nofollow sponsored' -%}{%- endif -%}
          {%- capture name_html -%}{% render 'gz-autolink', text: s.settings.name %}{%- endcapture -%}
          <tr class="gz-row--{{ rank }}">
            <td class="gz-table__rank">{{ rank }}</td>
            <th scope="row">
              <span class="gz-shop-id gz-shop-id--row">
                {%- render 'gz-shop-logo', s: s.settings, size: 34, alt: '' -%}
                {%- if name_html contains '<a ' -%}{{ name_html }}{%- else -%}<a href="#fiche-{{ rank }}">{{ s.settings.name | escape }}</a>{%- endif -%}
              </span>
            </th>
            <td class="gz-table__mono">{{ s.settings.entry | escape }}</td>
            <td>{{ s.settings.shipping | escape }}</td>
            <td class="gz-table__promo">{% if rank <= 3 and s.settings.promo != blank %}{{ s.settings.promo | escape }}{% else %}—{% endif %}</td>
            <td>{{ s.settings.spec | escape }}</td>
            <td class="gz-table__site">
              {%- if rank <= 3 and s.settings.url != blank -%}
                <a class="gz-btn gz-btn--inline gz-table__cta" href="{{ s.settings.url }}" rel="{{ rel }}" target="_blank">Visiter →</a>
              {%- else -%}
                <span class="gz-domain">{{ s.settings.domain | escape }}</span>
              {%- endif -%}
            </td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>
  </div>

  <ol class="gz-list">
    {%- for s in shops -%}
      {%- assign rank = forloop.index -%}
      {%- if s.settings.dofollow -%}{%- assign rel = 'noopener' -%}{%- else -%}{%- assign rel = 'nofollow sponsored' -%}{%- endif -%}
      {%- capture name_html -%}{% render 'gz-autolink', text: s.settings.name %}{%- endcapture -%}
      <li class="gz-row--{{ rank }}">
        <span class="gz-list__rank">{{ rank }}</span>
        <span class="gz-shop-id gz-shop-id--row">
          {%- render 'gz-shop-logo', s: s.settings, size: 34, alt: '' -%}
          {%- if name_html contains '<a ' -%}<span class="gz-list__name">{{ name_html }}</span>{%- else -%}<a class="gz-list__name" href="#fiche-{{ rank }}">{{ s.settings.name | escape }}</a>{%- endif -%}
        </span>
        <p class="gz-list__data">{{ s.settings.entry | escape }} · {{ s.settings.shipping | escape }} · {% if rank <= 3 and s.settings.promo != blank %}{{ s.settings.promo | escape }}{% else %}—{% endif %}</p>
        <div>
          {%- if rank <= 3 and s.settings.url != blank -%}
            <a class="gz-btn gz-btn--inline gz-list__cta" href="{{ s.settings.url }}" rel="{{ rel }}" target="_blank">Visiter →</a>
          {%- else -%}
            <span class="gz-domain">{{ s.settings.domain | escape }}</span>
          {%- endif -%}
        </div>
      </li>
    {%- endfor -%}
  </ol>
  {%- if section.settings.releve_note != blank -%}
    <p class="gz-releve__note">{{ section.settings.releve_note | escape }}</p>
  {%- endif -%}
</section>

<section id="dossier" class="gz-dossier" aria-labelledby="titre-dossier">
  <div class="gz-wrap">
    <p class="gz-kicker">{{ section.settings.dossier_kicker | escape }}</p>
    <h2 id="titre-dossier" class="gz-h2 gz-dossier__title">{{ section.settings.dossier_title | escape }}</h2>
    <div class="gz-dossier__grid">
      <nav class="gz-toc" aria-label="Sommaire des fiches">
        <p class="gz-toc__head">Sommaire</p>
        <ol>
          {%- for s in shops -%}
            <li><a href="#fiche-{{ forloop.index }}"><span>{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>{{ s.settings.name | escape }}</a></li>
          {%- endfor -%}
        </ol>
      </nav>
      <div class="gz-fiches">
        {%- for s in shops -%}
          {%- assign rank = forloop.index -%}
          {%- if s.settings.dofollow -%}{%- assign rel = 'noopener' -%}{%- else -%}{%- assign rel = 'nofollow sponsored' -%}{%- endif -%}
          {%- assign logo_alt = 'Logo ' | append: s.settings.name -%}
          <article id="fiche-{{ rank }}" class="gz-fiche gz-fiche--{{ rank }}">
            <div class="gz-fiche__tags">
              <span class="gz-tag">Fiche n°{% if rank < 10 %}0{% endif %}{{ rank }}</span>
              {%- if rank == 1 -%}<span class="gz-tag gz-tag--green">Élu meilleur site 2026</span>{%- endif -%}
              {%- if rank == 2 or rank == 3 -%}<span class="gz-tag gz-tag--orange">Podium</span>{%- endif -%}
              <span class="gz-fiche__spec">{{ s.settings.spec | escape }}</span>
            </div>
            <div class="gz-shop-id gz-shop-id--fiche">
              {%- render 'gz-shop-logo', s: s.settings, size: 64, alt: logo_alt -%}
              <h3 class="gz-fiche__title">{{ rank }}. {% render 'gz-autolink', text: s.settings.name %}</h3>
            </div>
            <p class="gz-fiche__dek">{% render 'gz-autolink', text: s.settings.dek %}</p>
            <div class="gz-fiche__grid">
              <div class="gz-fiche__main">
                {%- assign paras = s.settings.paras | newline_to_br | split: '<br />' -%}
                {%- for para in paras -%}
                  {%- assign txt = para | strip -%}
                  {%- if txt != blank -%}<p>{% render 'gz-autolink', text: txt %}</p>{%- endif -%}
                {%- endfor -%}
                <h4>Pour qui ?</h4>
                <p class="gz-fiche__forwho">{% render 'gz-autolink', text: s.settings.for_who %}</p>
              </div>
              <div class="gz-fiche__side">
                <dl class="gz-databox">
                  <div><dt>Prix dès</dt><dd>{{ s.settings.entry | escape }}</dd></div>
                  <div><dt>Livraison</dt><dd>{{ s.settings.shipping | escape }}</dd></div>
                  <div><dt>Code promo</dt><dd>{% if rank <= 3 and s.settings.promo != blank %}{{ s.settings.promo | escape }}{% else %}—{% endif %}</dd></div>
                  <div><dt>Site</dt><dd>{% if s.settings.dofollow and s.settings.url != blank %}<a class="gz-xlink" href="{{ s.settings.url }}" rel="{{ rel }}" target="_blank">{{ s.settings.domain | escape }}</a>{% else %}{{ s.settings.domain | escape }}{% endif %}</dd></div>
                </dl>
                <div class="gz-proscons gz-proscons--plus">
                  <h4>Les plus</h4>
                  <ul>
                    {%- assign items = s.settings.plus | newline_to_br | split: '<br />' -%}
                    {%- for item in items -%}{%- assign txt = item | strip -%}{%- if txt != blank -%}<li>{% render 'gz-autolink', text: txt %}</li>{%- endif -%}{%- endfor -%}
                  </ul>
                </div>
                <div class="gz-proscons gz-proscons--minus">
                  <h4>Les moins</h4>
                  <ul>
                    {%- assign items = s.settings.minus | newline_to_br | split: '<br />' -%}
                    {%- for item in items -%}{%- assign txt = item | strip -%}{%- if txt != blank -%}<li>{% render 'gz-autolink', text: txt %}</li>{%- endif -%}{%- endfor -%}
                  </ul>
                </div>
                {%- if rank <= 3 and s.settings.url != blank -%}
                  <a class="gz-btn gz-fiche__cta" href="{{ s.settings.url }}" rel="{{ rel }}" target="_blank">Visiter {{ s.settings.name | escape }} →</a>
                {%- endif -%}
              </div>
            </div>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<section id="duel" class="gz-duel" aria-labelledby="titre-duel" data-duel>
  <div class="gz-wrap">
    <p class="gz-kicker gz-kicker--on-ink">{{ section.settings.duel_kicker | escape }}</p>
    <h2 id="titre-duel" class="gz-h2 gz-duel__title">{% render 'gz-autolink', text: champion.settings.name %} contre…</h2>
    <p class="gz-duel__intro">{{ section.settings.duel_intro | escape }}</p>
    <div class="gz-duel__picker" role="group" aria-label="Choisir l'adversaire">
      {%- for r in rivals -%}
        {%- assign idx = r.settings.rank | minus: 1 -%}
        {%- assign b = shops[idx] -%}
        <button type="button" class="gz-duel__btn" data-rival aria-controls="duel-panel-{{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" {{ r.shopify_attributes }}>{{ b.settings.name | escape }}</button>
      {%- endfor -%}
    </div>
    {%- for r in rivals -%}
      {%- assign idx = r.settings.rank | minus: 1 -%}
      {%- assign b = shops[idx] -%}
      <div class="gz-duel__board" id="duel-panel-{{ forloop.index }}" role="region" aria-label="{{ champion.settings.name | escape }} contre {{ b.settings.name | escape }}"{% unless forloop.first %} hidden{% endunless %}>
        <div class="gz-duel__head">
          <p class="gz-duel__name gz-duel__name--a">{%- render 'gz-shop-logo', s: champion.settings, size: 36, alt: '' -%}<span>{% render 'gz-autolink', text: champion.settings.name %}</span></p>
          <p class="gz-duel__name">{%- render 'gz-shop-logo', s: b.settings, size: 36, alt: '' -%}<span>{% render 'gz-autolink', text: b.settings.name %}</span></p>
        </div>
        <div class="gz-duel__row">
          <p class="gz-duel__key">Prix dès</p>
          <div class="gz-duel__vals"><p>{{ champion.settings.entry | escape }}</p><p>{{ b.settings.entry | escape }}</p></div>
        </div>
        <div class="gz-duel__row">
          <p class="gz-duel__key">Livraison</p>
          <div class="gz-duel__vals"><p>{{ champion.settings.shipping | escape }}</p><p>{{ b.settings.shipping | escape }}</p></div>
        </div>
        <div class="gz-duel__row">
          <p class="gz-duel__key">Code promo</p>
          <div class="gz-duel__vals"><p>{% if champion.settings.promo != blank %}{{ champion.settings.promo | escape }}{% else %}—{% endif %}</p><p>{% if idx < 3 and b.settings.promo != blank %}{{ b.settings.promo | escape }}{% else %}—{% endif %}</p></div>
        </div>
        <div class="gz-duel__row">
          <p class="gz-duel__key">Spécificité</p>
          <div class="gz-duel__vals"><p>{{ champion.settings.spec | escape }}</p><p>{{ b.settings.spec | escape }}</p></div>
        </div>
        <div class="gz-duel__verdict">
          <span class="gz-duel__verdict-label">Verdict</span>
          <p>{% render 'gz-autolink', text: r.settings.verdict %}</p>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

<script type="application/ld+json">
{"@context":"https://schema.org","@type":"ItemList","name":{{ section.settings.itemlist_name | json }},"numberOfItems":{{ shops.size }},"itemListOrder":"https://schema.org/ItemListOrderDescending","itemListElement":[
{%- for s in shops -%}
{%- capture fallback_url -%}{{ request.origin }}/#fiche-{{ forloop.index }}{%- endcapture -%}
{"@type":"ListItem","position":{{ forloop.index }},"name":{{ s.settings.name | json }},"url":{% if forloop.index <= 3 and s.settings.url != blank %}{{ s.settings.url | json }}{% else %}{{ fallback_url | json }}{% endif %}{% if s.settings.logo != blank %},"image":{{ s.settings.logo | image_url: width: 256 | prepend: 'https:' | json }}{% endif %}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]}
</script>

{% schema %}
{"name":"Gazette · Classement","class":"gz-section","settings":[{"type":"header","content":"Podium"},{"type":"text","id":"podium_title","label":"Titre","default":"Le podium, en trois sachets"},{"type":"textarea","id":"podium_intro","label":"Texte","default":"Les trois seuls sites que nous recommandons sans réserve, et vers lesquels nous renvoyons."},{"type":"header","content":"Relevé"},{"type":"text","id":"releve_kicker","label":"Rubrique","default":"Rubrique · Le relevé"},{"type":"text","id":"releve_title","label":"Titre","default":"Tableau comparatif des 10 sites CBD"},{"type":"textarea","id":"releve_intro","label":"Texte","default":"Toutes les données relevées le 14 septembre 2026, dans l'ordre du classement."},{"type":"text","id":"releve_caption","label":"Légende du tableau (accessibilité)","default":"Comparatif des 10 meilleurs sites CBD en France, relevé du 14 septembre 2026"},{"type":"textarea","id":"releve_note","label":"Note sous le tableau","default":"* Prix de CBDSol relevé sur du trim et des mélanges, pas sur des fleurs entières."},{"type":"header","content":"Dossier"},{"type":"text","id":"dossier_kicker","label":"Rubrique","default":"Rubrique · Le dossier"},{"type":"text","id":"dossier_title","label":"Titre","default":"Les dix fiches, boutique par boutique"},{"type":"header","content":"Face-à-face"},{"type":"text","id":"duel_kicker","label":"Rubrique","default":"Rubrique · Face-à-face"},{"type":"textarea","id":"duel_intro","label":"Texte","default":"Choisissez un adversaire : on met les relevés côte à côte et on vous dit lequel prendre selon votre profil."},{"type":"header","content":"Données structurées"},{"type":"text","id":"itemlist_name","label":"Nom de la liste (JSON-LD ItemList)","default":"Les 10 meilleurs sites de CBD en France — 2026"}],"blocks":[{"type":"shop","name":"Boutique","settings":[{"type":"paragraph","content":"Le rang correspond à l'ordre des blocs Boutique. Lien et code promo ne s'affichent que pour les rangs 1 à 3."},{"type":"text","id":"name","label":"Nom"},{"type":"text","id":"domain","label":"Domaine affiché"},{"type":"image_picker","id":"logo","label":"Logo","info":"Carré de préférence. Sans logo, les initiales s'affichent."},{"type":"url","id":"url","label":"Lien (rangs 1-3)"},{"type":"checkbox","id":"dofollow","label":"Lien dofollow","info":"Coché : rel=\"noopener\". Décoché : rel=\"nofollow sponsored\".","default":false},{"type":"text","id":"entry","label":"Prix dès"},{"type":"text","id":"shipping","label":"Livraison"},{"type":"text","id":"promo","label":"Code promo (rangs 1-3)"},{"type":"text","id":"spec","label":"Spécificité"},{"type":"text","id":"contains","label":"Podium : « Contient : … »"},{"type":"textarea","id":"line","label":"Podium : phrase"},{"type":"textarea","id":"dek","label":"Fiche : chapô"},{"type":"textarea","id":"paras","label":"Fiche : paragraphes (un par ligne)"},{"type":"textarea","id":"for_who","label":"Fiche : pour qui ?"},{"type":"textarea","id":"plus","label":"Les plus (un par ligne)"},{"type":"textarea","id":"minus","label":"Les moins (un par ligne)"}]},{"type":"rival","name":"Adversaire (face-à-face)","settings":[{"type":"number","id":"rank","label":"Rang de l'adversaire dans le classement","default":2},{"type":"textarea","id":"verdict","label":"Verdict"}]}],"max_blocks":30,"presets":[{"name":"Gazette · Classement"}]}
{% endschema %}
