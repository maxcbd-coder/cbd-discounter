            "definition": "Cannabidiol. Cannabinoïde du chanvre, non stupéfiant, vendu en fleurs, résines, huiles ou infusions."
          }
        },
        "term-2": {
          "type": "term",
          "settings": {
            "term": "THC",
            "definition": "Tétrahydrocannabinol. Molécule psychoactive du cannabis, limitée à 0,3 % dans les produits au CBD vendus en France."
          }
        },
        "term-3": {
          "type": "term",
          "settings": {
            "term": "Fleur",
            "definition": "Sommité florale séchée du chanvre. C'est le format le plus vendu et celui qui sert de référence pour le prix au gramme."
          }
        },
        "term-4": {
          "type": "term",
          "settings": {
            "term": "Résine",
            "definition": "Produit obtenu à partir des trichomes de la plante, compressé en bloc ou en pollen."
          }
        },
        "term-5": {
          "type": "term",
          "settings": {
            "term": "Trim",
            "definition": "Petites feuilles et résidus de taille des fleurs. Moins cher, il est souvent utilisé en mélange."
          }
        },
        "term-6": {
          "type": "term",
          "settings": {
            "term": "Certificat d'analyse",
            "definition": "Rapport de laboratoire attestant des taux de cannabinoïdes d'un lot précis. Aussi appelé COA."
          }
        },
        "term-7": {
