    "guide": {
      "type": "gz-guide",
      "blocks": {
        "tip-1": {
          "type": "tip",
          "settings": {
            "title": "Comparez le prix au gramme",
            "text": "Le prix d'un sachet ne veut rien dire sans son poids. Ramenez toujours le prix au gramme pour comparer deux boutiques : c'est ce que nous faisons dans notre relevé."
          }
        },
        "tip-2": {
          "type": "tip",
          "settings": {
            "title": "Exigez le certificat d'analyse",
            "text": "Un certificat sérieux mentionne le numéro de lot, la date, le laboratoire et les taux de CBD et de THC. Sans lui, impossible de savoir ce que contient réellement le produit."
          }
        },
        "tip-3": {
          "type": "tip",
          "settings": {
            "title": "Vérifiez le taux de THC",
            "text": "En France, le THC doit rester à 0,3 % maximum dans le produit fini. Le chiffre figure sur le certificat d'analyse du lot."
          }
        },
        "tip-4": {
          "type": "tip",
          "settings": {
            "title": "Regardez l'heure limite d'expédition",
            "text": "Un délai de livraison ne commence qu'à l'expédition. Une heure limite affichée, comme 14h30 chez CBD Discounter, vous dit exactement quand votre colis partira."
          }
        },
        "tip-5": {
          "type": "tip",
          "settings": {
            "title": "Calculez le total, port compris",
            "text": "Un petit prix au gramme peut être annulé par des frais de port élevés. Comparez le montant final, après application du code promo."
          }
        },
        "tip-6": {
          "type": "tip",
          "settings": {
            "title": "Fleur, résine ou trim : choisissez en connaissance",
            "text": "Le trim et les mélanges sont moins chers que les fleurs entières. Ce n'est pas le même produit : comparez les prix à format égal."
          }
        },
        "tip-7": {
          "type": "tip",
          "settings": {
            "title": "Testez sur un petit format",
            "text": "Avant d'acheter en quantité, commandez un petit grammage pour juger de la qualité et du service de la boutique."
          }
        },
        "tip-8": {
          "type": "tip",
          "settings": {
            "title": "Méfiez-vous des paiements hors site",
            "text": "Une boutique fiable encaisse sur son propre site. Un lien de paiement envoyé par message ou un paiement en cryptomonnaie doit vous alerter."
          }
        },
        "tip-9": {
          "type": "tip",
          "settings": {
            "title": "Vérifiez les mentions légales",
            "text": "Raison sociale, SIRET et adresse doivent figurer sur le site. Sans eux, aucun recours n'est possible en cas de litige."
          }
        },
        "tip-10": {
          "type": "tip",
          "settings": {
            "title": "Fuyez les promesses de guérison",
            "text": "Le CBD n'est pas un médicament. Un site qui affirme qu'il soigne ou guérit une maladie enfreint la réglementation : c'est un mauvais signe."
          }
        }
      },
