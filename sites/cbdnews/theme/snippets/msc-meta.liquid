{%- comment -%}
  Balises meta à la marque du nom de domaine (CBD News), indépendantes du nom interne de la boutique Shopify.
  Titre et description de l'accueil définis ici ; les autres pages reprennent page_title / page_description.
{%- endcomment -%}
{%- liquid
  assign brand = 'CBD News'
  if template.name == 'index'
    assign seo_title = 'Top 10 des meilleurs sites CBD en France (2026) | CBD News'
    assign seo_description = "Palmarès 2026 des 10 meilleurs sites CBD en France : prix au gramme, livraison, codes promo. CBD Discounter n°1, dès 0,75 €/g avec le code DISCOUNTER15."
  else
    assign seo_title = page_title | append: ' | ' | append: brand
    assign seo_description = page_description
  endif
  assign og_url = canonical_url | default: request.origin
-%}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#0F2E1D">
<title>{{ seo_title | strip_html | escape }}</title>
{%- if seo_description != blank -%}
  <meta name="description" content="{{ seo_description | strip_html | escape }}">
{%- endif -%}
<link rel="canonical" href="{{ canonical_url }}">
<meta property="og:site_name" content="{{ brand }}">
<meta property="og:locale" content="fr_FR">
<meta property="og:type" content="{% if template.name == 'index' %}article{% else %}website{% endif %}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ seo_title | strip_html | escape }}">
{%- if seo_description != blank -%}
  <meta property="og:description" content="{{ seo_description | strip_html | escape }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ seo_title | strip_html | escape }}">
{%- if seo_description != blank -%}
  <meta name="twitter:description" content="{{ seo_description | strip_html | escape }}">
{%- endif -%}
